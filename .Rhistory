?.query_and_bind
# ---- 1. Test the helper in isolation with a mock query function ----
# If this works, the problem is not in .query_and_bind()
mock_fun <- function(q) list(123, "KEY", "Title", NA, "OK")
.query_and_bind(
queries    = c("A", "B"),
query_fun  = mock_fun,
id_colname = "CAS",
label      = "CAS"
)
# ---- 2. Call the real query functions directly ----
# Whichever of these prints the error is the culprit
identifier_standardiser(identifier = "50-00-0", type = "CAS", cache = cache)
synonym_search(name = "caffeine", cache = cache)
# Note: query_DB() calls synonym_search() positionally in the LMP retry
# (synonym_search(query, cache = cache)) but by name (name = q) elsewhere.
# Check the first argument really is called `name`.
names(formals(synonym_search))
names(formals(identifier_standardiser))
# ---- 3. Look for stray uses of `query` in the function bodies ----
grep("query", deparse(body(identifier_standardiser)), value = TRUE)
grep("query", deparse(body(synonym_search)), value = TRUE)
# ---- 4. Get a call stack, since tryCatch() hides where the error happened ----
withCallingHandlers(
identifier_standardiser(identifier = "50-00-0", type = "CAS", cache = cache),
error = function(e) print(sys.calls())
)
