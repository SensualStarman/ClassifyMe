# ---- 1. Find the failing query ----
# Wrap the query function so it reports anything with < 5 columns
checked_fun <- function(fun) {
function(q) {
result <- fun(q)
if (length(result) < 5) {
message("Short result for query: ", q)
str(result)
}
result
}
}
# Small sample first, so it's fast
test_data <- head(explorer_metadata, 5)
test_out <- query_DB(data = test_data, cache = cache)
# ---- 2. Inspect what the query functions actually return ----
r1 <- identifier_standardiser(identifier = "50-00-0", type = "CAS", cache = cache)
str(r1)
names(r1)
length(r1)          # should be 5: CID, InChIKey, Title, <type>, PubChem_Message
r2 <- synonym_search(name = "caffeine", cache = cache)
str(r2)
length(r2)
# ---- 3. Call it again, so the result comes from the cache this time ----
# Caching only started working after your last fix, so the cache-hit
# path has never run before
r1_cached <- identifier_standardiser(identifier = "50-00-0", type = "CAS", cache = cache)
identical(r1, r1_cached)
str(r1_cached)
# ---- 4. Loop over your real queries and flag the short ones ----
ids <- explorer_metadata$CAS[!is.na(explorer_metadata$CAS)]
lens <- vapply(ids, function(q) {
length(identifier_standardiser(identifier = q, type = "CAS", cache = cache))
}, integer(1))
table(lens)
ids[lens < 5]
